APP_BASE_URL=https://farmeragent.forum
HOST=127.0.0.1
PORT=3000

# Managed Postgres is recommended.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/farmeragent?sslmode=require
# Supabase pooler on 6543 usually needs sslmode=require.
DATABASE_URL=

# BSC mainnet RPC
# You can give either HTTP only, or both HTTP + WS.
# Keep these server-side only. Do not expose them in frontend JS.
# Example:
# BSC_RPC_URL=https://your-provider.example.com/xxxxxxxx
# BSC_WS_URL=wss://your-provider.example.com/xxxxxxxx
BSC_RPC_URL=
BSC_WS_URL=

# Optional for future real AI features
OPENAI_API_KEY=
